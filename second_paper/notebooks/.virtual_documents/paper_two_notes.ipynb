axs[0].plot([s_["R_km"] for s_ in seq], [s_["M"] for s_ in seq], "o-", label="co-expansion (measured radius)")
axs[0].plot([g_["R_km"] for g_ in gr], [g_["M"] for g_ in gr], "s--", label="GR (TOV)")
axs[0].set_xlabel("R [km]"); axs[0].set_ylabel(r"M [$M_\odot$]"); axs[0].set_title(r"Mass-radius, polytrope K=100, $\Gamma$=2"); axs[0].legend()
axs[1].semilogy([s_["M"] for s_ in seq], [-s_["delta"] for s_ in seq], "o-", label=r"co-expansion $-(M/E-1)$")
