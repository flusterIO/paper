# PSR J0337+1715: pulsar of 1.4378 M_sun; bound |(m_g/m_i)_NS - (m_g/m_i)_WD| = (0.5 +- 1.8) x 1e-6. White-dwarf delta ~ u^2 ~ 1e-10.
rows = []
for eos in (pf.polytrope_eos(100.0, 2.0), pf.polytrope_eos(3000.0, 2.5)):
    s = pf.interior_star_with_mass(pf.J0337_PULSAR_MASS, eos, dr=0.01, iters=16)
    rows.append(f"| co-expansion, {eos.label} | ${s['delta']:+.4f}$ | {abs(s['delta'])/pf.J0337_DELTA[1]:.0f}× | {s['R_km']:.1f} km | {s['binding_fraction']:.3f} |")
x = pf.interior_star(1.3, field="exponential", dr=0.01, iters=40, F_hi=10.0)
rows.append(f"| exponential metric, $M = {x['M']:.3f}$ | ${x['delta']:+.1e}$ | (numerical zero) | | |")
nb.printMarkdown("| star | $M/E - 1$ | vs. 95% bound | radius | binding |\n|---|---|---|---|---|\n" + "\n".join(rows))


