PALETTE = ["#2f5d8a", "#c0582b", "#4c9a5f", "#8a5aa8", "#b88a1e", "#5a5a5a"]

def lam(expr, *syms):
    "Turn a SymPy expression from the package into a NumPy function of `syms`."
    return smp.lambdify(syms, expr, "numpy")

def show(label, expr):
    display(Math(label + " = " + smp.latex(expr)))

# symbols used throughout (all quantities are lengths or ratios of lengths)
v, c, beta, x, w, tau, dx = smp.symbols("v c beta x w tau dx", positive=True)
R, Rs, L, Rstar = smp.symbols("R r_s L R_*", positive=True)
print("Loaded", sum(1 for n in dir(aw) if not n.startswith("_")), "paper functions.")


if VIDEO_URL:
    from IPython.display import YouTubeVideo
    m = re.search(r"(?:v=|youtu\.be/|embed/)([A-Za-z0-9_-]{11})", VIDEO_URL)
    display(YouTubeVideo(m.group(1), width=720, height=405) if m else Markdown(f"[Companion video]({VIDEO_URL})"))
display(Markdown(f"Paper: [{PAPER_URL}]({PAPER_URL}) · Package: [{PYPI_URL}]({PYPI_URL})"))





slope = aw.embedding_slope(v, c)
gam = aw.lorentz_gamma(v, c)
show(r"\partial_x y", slope)
show(r"\gamma", gam)
show(r"\left(1+(\partial_x y)^2\right)-\gamma^2", smp.simplify(aw.gamma_from_slope(slope)**2 - gam**2))


slope_f = lam(aw.embedding_slope(beta, 1), beta)

fig, (a1, a2) = plt.subplots(1, 2, figsize=(11, 4.6))
for b, col in zip([0.3, 0.6, 0.85], PALETTE):
    s = slope_f(b)
    a1.plot([0, 1, 1, 0], [0, 0, s, 0], color=col, lw=2, label=fr"$\beta={b}$:  $\gamma={np.hypot(1, s):.3f}$")
    a1.annotate(fr"$dS=\gamma\,dx$", (0.45, s / 2 + 0.06), color=col, fontsize=9, rotation=np.degrees(np.arctan(s)))
a1.annotate(r"$dx$", (0.48, -0.12)); a1.annotate(r"$dy=\beta\gamma\,dx$", (1.03, 0.5))
a1.set_xlim(-0.05, 1.5); a1.set_ylim(-0.2, 1.8); a1.set_aspect("equal")
a1.set_title("Lorentz triangles: base $dx$, height $dy$, hypotenuse $dS$"); a1.legend(loc="upper left", fontsize=9)

eta = np.linspace(0, 2.2, 300)
